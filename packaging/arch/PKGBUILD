# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooless-bin
_pkgname=ooless
pkgver=0.1.0
pkgrel=1
pkgdesc="Memory-bounded interactive terminal pager with regex highlight and jump navigation."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooless"
license=('Apache-2.0')
depends=('glibc')
provides=('ooless')
conflicts=('ooless')
source_x86_64=("${url}/releases/download/v${pkgver}/ooless-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooless-linux-x86_64" "${pkgdir}/usr/bin/ooless"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooless-uninstall"
}
